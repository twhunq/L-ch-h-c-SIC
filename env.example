# ========== Local bot (telegram_bot.py / start_bot.bat) ==========
TELEGRAM_BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat ID nhận thông báo (cách nhau bởi dấu phẩy nếu nhiều người)
# Lấy Chat ID: mở bot → /start (webhook) hoặc nhắn @userinfobot
TELEGRAM_CHAT_IDS=123456789

# ========== Vercel (Environment Variables trên dashboard) ==========
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_IDS=...
#
# Bảo vệ /api/cron và /api/setup-webhook (tự tạo chuỗi ngẫu nhiên)
# CRON_SECRET=doi-thanh-chuoi-bi-mat-dai
#
# Tùy chọn: secret cho Telegram webhook
# TELEGRAM_WEBHOOK_SECRET=doi-thanh-chuoi-khac
